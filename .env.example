# Compose-level variables (copy to .env, or just run setup.ps1 / setup.sh)
WEB_PORT=8080
DB_DATABASE=lms
DB_USERNAME=lms

# DB_PASSWORD and DB_ROOT_PASSWORD are generated by setup.ps1 / setup.sh.
# DB_PASSWORD=
# DB_ROOT_PASSWORD=

# Run `php artisan migrate --force` on every app start.
AUTO_MIGRATE=false

# Server only (written by setup.sh): skip the dev override file + use host bind paths
# COMPOSE_FILE=docker-compose.yml
# DB_DATA_PATH=/var/lib/lms/mariadb
# STORAGE_PATH=/var/lib/lms/storage
